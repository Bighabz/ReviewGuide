# QA loop secrets - copy to qa/.env (GITIGNORED, never commit).
# Service-role key for the qa.* tables (project qvowmjjcotdonezdtvur). Never logged.
SUPABASE_QA_KEY=
# Telegram is the P1 notify channel (Habib's call 2026-08-22).
# Bot token + target chat id for run/breach/dead-man alerts. Never logged.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# RingCentral SMS: on the VPS set this to the clawd stack sender
# (/home/clawd/me/morning-brief/bin/Send-Sms.ps1) and deploy-vps.sh flips notify_channel to "rc".
# Absolute path to the external RingCentral sender script (Send-RcSms / Send-Sms.ps1).
RC_SCRIPT_PATH=
# Optional bypass token for authenticated QA probes.
QA_BYPASS_TOKEN=
